# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing
/coverage

# Next.js
/.next/
/out/
*.rsc
tsconfig.tsbuildinfo

# Production
/build
/dist

# Misc
.DS_Store
*.pem

# Environment — NEVER commit real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
.env*
# ...but DO ship the template so the installer knows what to ask for.
# This negation MUST stay below every .env* rule: git applies the last
# matching pattern, so a broader .env* placed after it would re-ignore it.
!.env.local.example

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel

# IDE
.vscode
.idea
*.swp
*.swo
*~
.sublime-project
.sublime-workspace

# OS
Thumbs.db
.AppleDouble
.LSOverride

# Supabase (local CLI state)
supabase/.branches
supabase/.temp
# Filled cron SQL with the real CRON_SECRET — generated post-deploy, never commit
supabase/cron/*.filled.sql

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# NOTE: package-lock.json is intentionally NOT ignored.
# A distribution template must ship its lockfile for reproducible installs.

# Forge — local agent tooling, not part of the SaaS. This is a distribution
# repo: keeping these out means installers don't inherit someone else's
# skills, agents, or CLAUDE.md.
/.claude/
/.forge/
/CLAUDE.md
/example.mcp.json
